# Copy to .env and fill in. .env is git-ignored and only read by the Node scripts in scripts/ —
# it is never bundled into the Remotion (browser) code.

# Tripo API key from https://platform.tripo3d.ai (Console → API Keys). Starts with "tsk_".
TRIPO_API_KEY=

# Optional overrides
# TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
# TRIPO_IMAGE_MODEL=seedream_v5
# TRIPO_REFINE_MODEL=chat_image_2
# TRIPO_MODEL_VERSION=P2-20260801
# TRIPO_TEXTURE_QUALITY=detailed
# TRIPO_GAME_FORMAT=glb   # or fbx for Unity/Unreal
# TRIPO_POLL_TIMEOUT_MINUTES=25
